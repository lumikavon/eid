{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://eid.local/contracts/attachment-v1.schema.json",
  "title":"Quarantined attachment parse result v1",
  "type":"object","additionalProperties":false,
  "required":["id","sha256","kind","byte_length","state","pages","chunks"],
  "properties":{
    "id":{"type":"string","format":"uuid"},
    "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "kind":{"enum":["pdf","docx","xlsx","png","jpeg"]},
    "byte_length":{"type":"integer","minimum":1,"maximum":10485760},
    "state":{"enum":["QUEUED","RUNNING","PARTIAL","SUCCEEDED","FAILED","BLOCKED"]},
    "pages":{"type":"array","maxItems":500,"items":{"type":"object","additionalProperties":false,"required":["page_number","section","state","error_code"],"properties":{"page_number":{"type":"integer","minimum":1,"maximum":500},"section":{"type":"string","maxLength":256},"state":{"enum":["PARSED","OCR","FAILED"]},"error_code":{"type":["string","null"]}}}},
    "chunks":{"type":"array","maxItems":1000,"items":{"type":"object","additionalProperties":false,"required":["page_number","ordinal","locator","content","content_hash"],"properties":{"page_number":{"type":"integer","minimum":1,"maximum":500},"ordinal":{"type":"integer","minimum":1,"maximum":200},"locator":{"type":"string","minLength":1,"maxLength":512},"content":{"type":"string","minLength":1,"maxLength":4000},"content_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}}
  }
}
