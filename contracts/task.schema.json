{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eid.local/contracts/task.schema.json",
  "$defs": {
    "AttachmentJobSnapshot": {
      "additionalProperties": false,
      "properties": {
        "id": {"format": "uuid", "title": "Id", "type": "string"},
        "document_id": {"format": "uuid", "title": "Document Id", "type": "string"},
        "state": {"enum": ["QUEUED", "RUNNING", "PARTIAL", "SUCCEEDED", "FAILED", "BLOCKED"], "title": "State", "type": "string"},
        "error_code": {"anyOf": [{"pattern": "^[A-Z_]{1,64}$", "type": "string"}, {"type": "null"}], "title": "Error Code"},
        "attempt": {"maximum": 3, "minimum": 0, "title": "Attempt", "type": "integer"},
        "created_at": {"format": "date-time", "title": "Created At", "type": "string"},
        "updated_at": {"format": "date-time", "title": "Updated At", "type": "string"}
      },
      "required": ["id", "document_id", "state", "error_code", "attempt", "created_at", "updated_at"],
      "title": "AttachmentJobSnapshot",
      "type": "object"
    },
    "EventPage": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "items": {
            "$ref": "#/$defs/TaskEventView"
          },
          "maxItems": 64,
          "title": "Data",
          "type": "array"
        },
        "current_seq": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Current Seq",
          "type": "integer"
        },
        "retention_floor": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Retention Floor",
          "type": "integer"
        },
        "reset_required": {
          "default": false,
          "title": "Reset Required",
          "type": "boolean"
        }
      },
      "required": [
        "data",
        "current_seq",
        "retention_floor"
      ],
      "title": "EventPage",
      "type": "object"
    },
    "InventoryInput": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "default": 50,
          "maximum": 50,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        }
      },
      "title": "InventoryInput",
      "type": "object"
    },
    "InventoryItem": {
      "additionalProperties": false,
      "properties": {
        "resource_id": {
          "format": "uuid",
          "title": "Resource Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "document",
            "knowledge",
            "reference"
          ],
          "title": "Kind",
          "type": "string"
        },
        "revision": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "resource_epoch": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Resource Epoch",
          "type": "integer"
        }
      },
      "required": [
        "resource_id",
        "kind",
        "revision",
        "resource_epoch"
      ],
      "title": "InventoryItem",
      "type": "object"
    },
    "InventoryResult": {
      "additionalProperties": false,
      "properties": {
        "result_id": {
          "format": "uuid",
          "title": "Result Id",
          "type": "string"
        },
        "task_id": {
          "format": "uuid",
          "title": "Task Id",
          "type": "string"
        },
        "workspace_id": {
          "format": "uuid",
          "title": "Workspace Id",
          "type": "string"
        },
        "measured_at": {
          "format": "date-time",
          "title": "Measured At",
          "type": "string"
        },
        "scope": {
          "const": "first_authorized_visible_records",
          "title": "Scope",
          "type": "string"
        },
        "limit": {
          "maximum": 50,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/InventoryItem"
          },
          "maxItems": 50,
          "title": "Items",
          "type": "array"
        },
        "policy_epoch": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            },
            {
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            },
            {
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            }
          ],
          "title": "Policy Epoch",
          "type": "array"
        }
      },
      "required": [
        "result_id",
        "task_id",
        "workspace_id",
        "measured_at",
        "scope",
        "limit",
        "items",
        "policy_epoch"
      ],
      "title": "InventoryResult",
      "type": "object"
    },
    "NotificationPage": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "items": {
            "$ref": "#/$defs/NotificationView"
          },
          "maxItems": 25,
          "title": "Data",
          "type": "array"
        },
        "next_cursor": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Cursor"
        }
      },
      "required": [
        "data"
      ],
      "title": "NotificationPage",
      "type": "object"
    },
    "NotificationResponse": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "$ref": "#/$defs/NotificationView"
        }
      },
      "required": [
        "data"
      ],
      "title": "NotificationResponse",
      "type": "object"
    },
    "NotificationUnreadResponse": {
      "additionalProperties": false,
      "properties": {
        "has_unread": {
          "title": "Has Unread",
          "type": "boolean"
        }
      },
      "required": [
        "has_unread"
      ],
      "title": "NotificationUnreadResponse",
      "type": "object"
    },
    "NotificationView": {
      "additionalProperties": false,
      "properties": {
        "notification_id": {
          "format": "uuid",
          "title": "Notification Id",
          "type": "string"
        },
        "task_id": {
          "format": "uuid",
          "title": "Task Id",
          "type": "string"
        },
        "event_seq": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Event Seq",
          "type": "integer"
        },
        "event_type": {
          "enum": [
            "task.succeeded",
            "task.blocked",
            "task.failed",
            "task.cancelled",
            "task.dead_letter"
          ],
          "title": "Event Type",
          "type": "string"
        },
        "state": {
          "enum": [
            "SUCCEEDED",
            "BLOCKED",
            "FAILED",
            "CANCELLED",
            "DEAD_LETTER"
          ],
          "title": "State",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "read_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Read At"
        }
      },
      "required": [
        "notification_id",
        "task_id",
        "event_seq",
        "event_type",
        "state",
        "created_at"
      ],
      "title": "NotificationView",
      "type": "object"
    },
    "ResultResponse": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "$ref": "#/$defs/InventoryResult"
        }
      },
      "required": [
        "data"
      ],
      "title": "ResultResponse",
      "type": "object"
    },
    "SubmitTask": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "inventory",
          "title": "Operation",
          "type": "string"
        },
        "input": {
          "$ref": "#/$defs/InventoryInput"
        },
        "depends_on": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 8,
          "title": "Depends On",
          "type": "array"
        }
      },
      "required": [
        "operation"
      ],
      "title": "SubmitTask",
      "type": "object"
    },
    "TaskEnvelope": {
      "additionalProperties": false,
      "properties": {
        "message_schema_version": {
          "const": "1.0",
          "title": "Message Schema Version",
          "type": "string"
        },
        "source": {
          "const": "eid-api",
          "title": "Source",
          "type": "string"
        },
        "event_id": {
          "format": "uuid",
          "title": "Event Id",
          "type": "string"
        },
        "event_type": {
          "const": "task.inventory.requested",
          "title": "Event Type",
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "aggregate_id": {
          "format": "uuid",
          "title": "Aggregate Id",
          "type": "string"
        },
        "aggregate_version": {
          "const": 1,
          "title": "Aggregate Version",
          "type": "integer"
        },
        "task_id": {
          "format": "uuid",
          "title": "Task Id",
          "type": "string"
        },
        "category": {
          "const": "integration",
          "title": "Category",
          "type": "string"
        },
        "input_ref": {
          "format": "uuid",
          "title": "Input Ref",
          "type": "string"
        },
        "input_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Hash",
          "type": "string"
        },
        "actor_id": {
          "format": "uuid",
          "title": "Actor Id",
          "type": "string"
        },
        "workspace_id": {
          "format": "uuid",
          "title": "Workspace Id",
          "type": "string"
        },
        "delegation_id": {
          "format": "uuid",
          "title": "Delegation Id",
          "type": "string"
        },
        "request_id": {
          "pattern": "^[A-Za-z0-9._-]{1,128}$",
          "title": "Request Id",
          "type": "string"
        },
        "trace_id": {
          "pattern": "^[0-9a-f]{32}$",
          "title": "Trace Id",
          "type": "string"
        }
      },
      "required": [
        "message_schema_version",
        "source",
        "event_id",
        "event_type",
        "occurred_at",
        "aggregate_id",
        "aggregate_version",
        "task_id",
        "category",
        "input_ref",
        "input_hash",
        "actor_id",
        "workspace_id",
        "delegation_id",
        "request_id",
        "trace_id"
      ],
      "title": "TaskEnvelope",
      "type": "object"
    },
    "TaskEventView": {
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "format": "uuid",
          "title": "Task Id",
          "type": "string"
        },
        "seq": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Seq",
          "type": "integer"
        },
        "event_type": {
          "enum": [
            "task.queued",
            "task.running",
            "task.retry_wait",
            "task.succeeded",
            "task.blocked",
            "task.failed",
            "task.cancelled",
            "task.dead_letter",
            "task.cancel_requested"
          ],
          "title": "Event Type",
          "type": "string"
        },
        "state": {
          "enum": [
            "QUEUED",
            "RUNNING",
            "RETRY_WAIT",
            "SUCCEEDED",
            "BLOCKED",
            "FAILED",
            "CANCELLED",
            "DEAD_LETTER"
          ],
          "title": "State",
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "seq",
        "event_type",
        "state",
        "occurred_at"
      ],
      "title": "TaskEventView",
      "type": "object"
    },
    "TaskPage": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "items": {
            "$ref": "#/$defs/TaskSnapshot"
          },
          "maxItems": 25,
          "title": "Data",
          "type": "array"
        },
        "next_cursor": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Cursor"
        }
      },
      "required": [
        "data"
      ],
      "title": "TaskPage",
      "type": "object"
    },
    "TaskResponse": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "$ref": "#/$defs/TaskSnapshot"
        }
      },
      "required": [
        "data"
      ],
      "title": "TaskResponse",
      "type": "object"
    },
    "TaskSnapshot": {
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "format": "uuid",
          "title": "Task Id",
          "type": "string"
        },
        "state": {
          "enum": [
            "QUEUED",
            "RUNNING",
            "RETRY_WAIT",
            "SUCCEEDED",
            "BLOCKED",
            "FAILED",
            "CANCELLED",
            "DEAD_LETTER"
          ],
          "title": "State",
          "type": "string"
        },
        "stage": {
          "enum": [
            "waiting",
            "inventory",
            "working",
            "retry_wait",
            "done",
            "blocked",
            "failed",
            "cancelled",
            "dead_letter"
          ],
          "title": "Stage",
          "type": "string"
        },
        "category": {
          "enum": [
            "generation",
            "retrieval",
            "review",
            "parse_ocr",
            "render",
            "integration"
          ],
          "title": "Category",
          "type": "string"
        },
        "operation": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Operation",
          "type": "string"
        },
        "parent_task_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Task Id"
        },
        "attempt": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Attempt",
          "type": "integer"
        },
        "fence_token": {
          "default": 0,
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Fence Token",
          "type": "integer"
        },
        "current_seq": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Current Seq",
          "type": "integer"
        },
        "retention_floor": {
          "default": 1,
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Retention Floor",
          "type": "integer"
        },
        "progress": {
          "default": null,
          "title": "Progress",
          "type": "null"
        },
        "result_ref": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Result Ref"
        },
        "error": {
          "anyOf": [
            {
              "enum": [
                "AUTHORIZATION_EXPIRED_OR_REVOKED",
                "DEPENDENCY_BLOCKED",
                "INVALID_INVENTORY_INPUT",
                "TRANSIENT_DEPENDENCY",
                "FORMAT_REPAIRABLE",
                "LEASE_EXPIRED",
                "ATTEMPTS_EXHAUSTED",
                "CANCELLED_BY_ACTOR",
                "OUTBOX_POISONED"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Error"
        },
        "error_class": {
          "anyOf": [
            {
              "enum": [
                "TRANSIENT",
                "FORMAT",
                "PERMANENT",
                "LEASE_EXPIRED",
                "ATTEMPTS_EXHAUSTED"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Class"
        },
        "next_retry_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Retry At"
        },
        "cancel_requested": {
          "default": false,
          "title": "Cancel Requested",
          "type": "boolean"
        },
        "external_effect_state": {
          "default": "none",
          "enum": [
            "none",
            "receipt_pending",
            "unknown",
            "confirmed"
          ],
          "title": "External Effect State",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "status_url": {
          "title": "Status Url",
          "type": "string"
        },
        "result_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Result Url"
        },
        "can_cancel": {
          "default": false,
          "title": "Can Cancel",
          "type": "boolean"
        },
        "can_retry": {
          "default": false,
          "title": "Can Retry",
          "type": "boolean"
        },
        "action_reason": {
          "anyOf": [
            {
              "enum": [
                "OPERATION_UNAVAILABLE",
                "EXTERNAL_EFFECT_UNKNOWN",
                "TASK_TERMINAL",
                "TASK_NOT_TERMINAL"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action Reason"
        }
      },
      "required": [
        "task_id",
        "state",
        "stage",
        "category",
        "operation",
        "attempt",
        "current_seq",
        "result_ref",
        "error",
        "created_at",
        "updated_at",
        "status_url",
        "result_url"
      ],
      "title": "TaskSnapshot",
      "type": "object"
    }
  },
  "anyOf": [
    {"$ref": "#/$defs/AttachmentJobSnapshot"},
    {
      "$ref": "#/$defs/SubmitTask"
    },
    {
      "$ref": "#/$defs/TaskEnvelope"
    },
    {
      "$ref": "#/$defs/TaskResponse"
    },
    {
      "$ref": "#/$defs/ResultResponse"
    },
    {
      "$ref": "#/$defs/TaskPage"
    },
    {
      "$ref": "#/$defs/EventPage"
    },
    {
      "$ref": "#/$defs/NotificationPage"
    },
    {
      "$ref": "#/$defs/NotificationResponse"
    },
    {
      "$ref": "#/$defs/NotificationUnreadResponse"
    }
  ]
}
