{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eid.local/contracts/document-ast-v1.schema.json",
  "title": "EID editor-independent domain document AST 1.0",
  "description": "Wire format for immutable document versions. Server additionally checks globally unique stable IDs, authorization, immutable metadata, existing opaque nodes and current media references.",
  "type": "object",
  "required": ["schema_version", "document"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "document": {
      "type": "object",
      "required": ["metadata", "sections", "claims", "citations", "review_state"],
      "properties": {
        "metadata": {
          "type": "object",
          "required": ["title", "document_type", "knowledge_scope", "template_version_id"],
          "properties": {
            "title": {"type": "string", "minLength": 1, "maxLength": 256},
            "document_type": {"type": "string"},
            "knowledge_scope": {"type": "string"},
            "template_version_id": {"$ref": "#/$defs/id"}
          },
          "additionalProperties": true
        },
        "sections": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "object", "required": ["id", "title", "blocks"], "properties": {"id": {"$ref": "#/$defs/id"}, "title": {"type": "string", "minLength": 1, "maxLength": 256}, "blocks": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/block"}}}, "additionalProperties": true}},
        "claims": {"$ref": "#/$defs/bindings"},
        "citations": {"$ref": "#/$defs/bindings"},
        "test_baselines": {"type": "array", "maxItems": 128, "items": {"type": "object", "required": ["document_id", "version_id"], "properties": {"document_id": {"$ref": "#/$defs/id"}, "version_id": {"$ref": "#/$defs/id"}}, "additionalProperties": false}},
        "review_state": {"type": "object"}
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "id": {"type": "string", "format": "uuid"},
    "bindings": {"type": "array", "maxItems": 2048, "items": {"type": "object", "required": ["id"], "properties": {"id": {"$ref": "#/$defs/id"}}, "additionalProperties": true}},
    "mark": {"oneOf": [{"type": "object", "required": ["type"], "properties": {"type": {"enum": ["bold", "italic", "underline"]}}, "additionalProperties": false}, {"type": "object", "required": ["type", "value"], "properties": {"type": {"const": "color"}, "value": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"}}, "additionalProperties": false}, {"type": "object", "required": ["type", "href"], "properties": {"type": {"const": "link"}, "href": {"type": "string", "maxLength": 2048, "pattern": "^https?://"}}, "additionalProperties": false}]},
    "run": {"type": "object", "required": ["text"], "properties": {"text": {"type": "string"}, "marks": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/mark"}}}, "additionalProperties": true},
    "textContent": {"type": "object", "required": ["text"], "properties": {"text": {"type": "string"}, "runs": {"type": "array", "maxItems": 2048, "items": {"$ref": "#/$defs/run"}}, "align": {"enum": ["left", "center", "right", "justify"]}}, "additionalProperties": true},
    "cell": {"type": "object", "required": ["text"], "properties": {"text": {"type": "string", "maxLength": 4096}, "rowspan": {"type": "integer", "minimum": 1, "maximum": 64}, "colspan": {"type": "integer", "minimum": 1, "maximum": 64}}, "additionalProperties": true},
    "block": {"type": "object", "required": ["id", "type", "content"], "properties": {
      "id": {"$ref": "#/$defs/id"},
      "type": {"type": "string", "minLength": 1},
      "content": {"type": "object"}
    }, "allOf": [
      {"if": {"properties": {"type": {"const": "paragraph"}}}, "then": {"properties": {"content": {"allOf": [{"$ref": "#/$defs/textContent"}, {"properties": {"list": {"enum": ["bullet", "ordered"]}}}]}}}},
      {"if": {"properties": {"type": {"const": "heading"}}}, "then": {"properties": {"content": {"allOf": [{"$ref": "#/$defs/textContent"}, {"required": ["level"], "properties": {"level": {"type": "integer", "minimum": 1, "maximum": 6}}}]}}}},
      {"if": {"properties": {"type": {"enum": ["warning", "code", "diagram", "citation"]}}}, "then": {"properties": {"content": {"$ref": "#/$defs/textContent"}}}},
      {"if": {"properties": {"type": {"const": "table"}}}, "then": {"properties": {"content": {"type": "object", "required": ["rows"], "properties": {"rows": {"type": "array", "maxItems": 256, "items": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/cell"}}}}, "additionalProperties": true}}}},
      {"if": {"properties": {"type": {"const": "figure"}}}, "then": {"properties": {"content": {"type": "object", "required": ["resource_id", "alt", "width", "height"], "properties": {"resource_id": {"$ref": "#/$defs/id"}, "alt": {"type": "string", "minLength": 1, "maxLength": 512}, "width": {"type": "integer", "minimum": 1, "maximum": 8192}, "height": {"type": "integer", "minimum": 1, "maximum": 8192}}, "additionalProperties": true}}}},
      {"if": {"properties": {"type": {"const": "requirement"}}}, "then": {"properties": {"content": {"type": "object", "description": "Draft fields may be empty; Review enforces type-specific completeness and current provenance.", "properties": {"requirement_id": {"type": "string", "maxLength": 4096}, "statement": {"type": "string", "maxLength": 2048}, "verification_method": {"type": "string", "maxLength": 2048}, "condition": {"type": "string", "maxLength": 2048}, "metric": {"type": "string", "maxLength": 2048}, "unit": {"type": "string", "maxLength": 2048}, "threshold": {"type": "string", "maxLength": 2048}, "source_refs": {"type": "array", "uniqueItems": true, "maxItems": 128, "items": {"$ref": "#/$defs/id"}}}, "additionalProperties": true}}}},
      {"if": {"properties": {"type": {"enum": ["test_item", "test_case", "acceptance"]}}}, "then": {"properties": {"content": {"type": "object", "properties": {"links": {"type": "array", "maxItems": 128, "items": {"type": "object", "required": ["document_id", "version_id", "section_id", "block_id"], "properties": {"document_id": {"$ref": "#/$defs/id"}, "version_id": {"$ref": "#/$defs/id"}, "section_id": {"$ref": "#/$defs/id"}, "block_id": {"$ref": "#/$defs/id"}}, "additionalProperties": false}}}, "additionalProperties": true}}}},
      {"if": {"properties": {"type": {"const": "form"}}}, "then": {"properties": {"content": {"type": "object", "required": ["field_id", "label"], "properties": {"field_id": {"type": "string", "minLength": 1, "maxLength": 128}, "label": {"type": "string", "minLength": 1, "maxLength": 256}, "value": {"type": "string", "maxLength": 4096}}, "additionalProperties": true}}}}
    ], "additionalProperties": true}
  }
}
